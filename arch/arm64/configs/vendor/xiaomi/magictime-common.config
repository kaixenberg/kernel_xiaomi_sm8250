# Local Version
CONFIG_LOCALVERSION="-NidhiKernel"
CONFIG_LOCALVERSION_AUTO=y

# PELT
# CONFIG_FAIR_GROUP_SCHED is not set
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_UCLAMP_BUCKETS_COUNT=20
CONFIG_RT_SOFTIRQ_AWARE_SCHED=y
CONFIG_SCHED_THERMAL_PRESSURE=y
CONFIG_SCHED_CASS=y

# RCU
CONFIG_RCU_BOOST=y
CONFIG_RCU_LAZY=y

# TEO
CONFIG_CPU_IDLE_GOV_TEO=y

# CRYPTO
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_LZO=y

# ZRAM
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_LZ4=y

# BPF
CONFIG_FAKE_UNAME_5_15=y

# NET
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y

# CPUSETs
CONFIG_CPUSET_ASSIST=n
CONFIG_CPUSET_BG="0-3"
CONFIG_CPUSET_CAMERA="0-7"
CONFIG_CPUSET_FG="0-6"
CONFIG_CPUSET_RESTRICTED="0-3"
CONFIG_CPUSET_SYSTEM_BG="0-3"
CONFIG_CPUSET_TOP_APP="0-7"

# ARM
CONFIG_ARM64_AMU_EXTN=n

# KernelSU
CONFIG_KSU=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
CONFIG_KSU_SUSFS_PRIORITY_UID_FILTER=y
CONFIG_SECCOMP=y

# Baseband Guard
CONFIG_BBG=y

# NoMount
CONFIG_NOMOUNT=y

# Efficient clocks
CONFIG_EFFCPU=y
CONFIG_EFFGPU=y

# CPU tuning
CONFIG_ARM64_TUNE_SM8250=y

# Display
CONFIG_K11A_PANEL_90HZ=y
CONFIG_DRM_MSM_BACKLIGHT_MIN=y
CONFIG_DRM_SDE_EXPO=y

# Power
CONFIG_BOEFFLA_WL_BLOCKER=y

# Memory
CONFIG_KCOMPRESSD=y
CONFIG_LZ4_ARM64_NEON=y

# Re:Kernel
CONFIG_REKERNEL=y

# USB
CONFIG_USB_MASS_STORAGE=m

# NTSYNC
CONFIG_NTSYNC=y

# Droidspaces
CONFIG_DROIDSPACES=y

# MIUI
CONFIG_RTMM=y
